MONGODB_URI=
JWT_ACCESS_SECRET=
CLIENT_URL=
PORT=
# Email, option 1 (local): Gmail SMTP with an app password
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Email, option 2 (production): Brevo HTTP API. Used instead of Gmail when set.
BREVO_API_KEY=
MAIL_FROM=
REDIS_URL=
# AI hints (OpenRouter). Without a key, students get fixed fallback hints instead.
# Set a credit limit on the key in the OpenRouter dashboard: that is the hard spending cap.
OPENROUTER_API_KEY=
# Optional: defaults to anthropic/claude-haiku-5.5
AI_MODEL=
# Optional: AI_DISABLED=true switches AI off without removing the key
AI_DISABLED=
# Production only: shared with the Vercel middleware so the API can trust the client IP it
# forwards for /api/auth/* (rate limits). Not needed locally.
PROXY_SECRET=
# Production only: encrypts two-factor secrets (32 random bytes, base64). Locally a development
# key is derived automatically.
MFA_ENCRYPTION_KEY=
